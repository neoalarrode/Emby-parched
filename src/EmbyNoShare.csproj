<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <!-- Código que se copia dentro de Emby (ver runtime/): se compila antes y va incrustado en el parcheador -->
  <ItemGroup>
    <ProjectReference Include="../runtime/EmbyNoShare.Runtime.csproj" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;TrimMode" />
    <EmbeddedResource Include="../runtime/bin/out/EmbyNoShare.Runtime.dll" LogicalName="EmbyNoShare.Runtime.dll" />
  </ItemGroup>

</Project>
